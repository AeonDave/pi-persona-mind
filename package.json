{
  "name": "@aeondave/pi-persona-mind",
  "version": "0.9.0",
  "private": false,
  "type": "module",
  "description": "Local memory for Pi with pi-persona — durable project and persona facts, session notes, bounded retrieval, and supervised automatic consolidation.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "memory",
    "agent-memory",
    "persistent-memory",
    "persona",
    "long-term-memory",
    "short-term-memory",
    "backlog",
    "pi-persona"
  ],
  "author": "AeonDave",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AeonDave/pi-persona-mind.git"
  },
  "homepage": "https://github.com/AeonDave/pi-persona-mind#readme",
  "bugs": {
    "url": "https://github.com/AeonDave/pi-persona-mind/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "docs/DESIGN.md",
    "docs/MEMORY-RESEARCH.md",
    "assets/banner.png",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./test/setup/hermetic-env.ts --test test/*.test.ts",
    "eval:memory": "node --import tsx scripts/evaluate-memory.ts",
    "verify": "npm run typecheck && npm test"
  },
  "pi": {
    "image": "https://raw.githubusercontent.com/AeonDave/pi-persona-mind/v0.9.0/assets/banner.png",
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@aeondave/pi-persona": ">=1.18.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@aeondave/pi-persona": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typebox": "*",
    "typescript": "^7.0.2"
  }
}
