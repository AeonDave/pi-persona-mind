{
  "name": "pi-persona-mind",
  "version": "0.8.3",
  "private": false,
  "type": "module",
  "description": "Persona-aware persistent memory and a short-lived task backlog for Pi, with automatic capture and bounded context injection.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "memory",
    "agent-memory",
    "persistent-memory",
    "persona",
    "long-term-memory",
    "short-term-memory",
    "backlog",
    "pi-persona"
  ],
  "author": "AeonDave",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AeonDave/pi-persona-mind.git"
  },
  "homepage": "https://github.com/AeonDave/pi-persona-mind#readme",
  "bugs": {
    "url": "https://github.com/AeonDave/pi-persona-mind/issues"
  },
  "files": [
    "src",
    "docs/DESIGN.md",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./test/setup/hermetic-env.ts --test test/*.test.ts",
    "verify": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typebox": "*",
    "typescript": "^7.0.2"
  }
}
